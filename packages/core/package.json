{
    "name": "@canvas-tile-engine/core",
    "version": "0.11.0",
    "description": "Renderer-agnostic core of Canvas Tile Engine: camera, pan/zoom, coordinate transforms, events, layered draw API, sprites, and spatial indexing for zoomable 2D grids. Install it with a renderer package.",
    "author": "Enes Yüksel",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/enesyukselx/canvas-tile-engine.git",
        "directory": "packages/core"
    },
    "homepage": "https://canvastileengine.dev",
    "bugs": {
        "url": "https://github.com/enesyukselx/canvas-tile-engine/issues"
    },
    "keywords": [
        "canvas-tile-engine",
        "tile",
        "tilemap",
        "grid",
        "2d",
        "map",
        "game-board",
        "engine",
        "camera",
        "pan",
        "zoom",
        "canvas",
        "renderer-agnostic",
        "spatial-index",
        "typescript"
    ],
    "sideEffects": false,
    "main": "dist/index.cjs",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "typecheck": "tsc --noEmit",
        "lint": "oxlint",
        "format": "oxfmt",
        "format:check": "oxfmt --check",
        "test": "vitest run",
        "test:platform-types": "node tests/package-types.mjs",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage"
    },
    "dependencies": {
        "rbush": "^4.0.1"
    },
    "devDependencies": {
        "@types/rbush": "^4.0.0"
    }
}
