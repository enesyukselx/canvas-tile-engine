{
    "name": "@canvas-tile-engine/renderer-webgl",
    "version": "0.7.0",
    "description": "WebGL renderer for Canvas Tile Engine: batched GPU drawing of shapes, images, lines, paths, and grid lines in the browser. Requires @canvas-tile-engine/core.",
    "author": "Enes Yüksel",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/enesyukselx/canvas-tile-engine.git",
        "directory": "packages/renderer-webgl"
    },
    "homepage": "https://canvastileengine.dev",
    "bugs": {
        "url": "https://github.com/enesyukselx/canvas-tile-engine/issues"
    },
    "keywords": [
        "canvas-tile-engine",
        "renderer",
        "webgl",
        "webgl2",
        "gpu",
        "canvas",
        "browser",
        "tile",
        "grid",
        "2d",
        "map"
    ],
    "sideEffects": false,
    "main": "dist/index.cjs",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "typecheck": "tsc --noEmit",
        "lint": "oxlint",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "format": "oxfmt",
        "format:check": "oxfmt --check"
    },
    "peerDependencies": {
        "@canvas-tile-engine/core": ">=0.12.0"
    },
    "devDependencies": {
        "@canvas-tile-engine/core": "workspace:^",
        "@canvas-tile-engine/renderer-shared": "workspace:^"
    }
}
