{
    "name": "@canvas-tile-engine/renderer-skia",
    "version": "0.6.0",
    "description": "React Native Skia renderer for Canvas Tile Engine. Most apps use it through @canvas-tile-engine/react-native.",
    "author": "Enes Yüksel",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/enesyukselx/canvas-tile-engine.git",
        "directory": "packages/renderer-skia"
    },
    "homepage": "https://canvastileengine.dev",
    "bugs": {
        "url": "https://github.com/enesyukselx/canvas-tile-engine/issues"
    },
    "keywords": [
        "canvas-tile-engine",
        "renderer",
        "skia",
        "react-native-skia",
        "react-native",
        "tile",
        "grid",
        "2d",
        "map"
    ],
    "sideEffects": false,
    "main": "dist/index.cjs",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "typecheck": "tsc --noEmit",
        "lint": "oxlint",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "format": "oxfmt",
        "format:check": "oxfmt --check"
    },
    "peerDependencies": {
        "@canvas-tile-engine/core": ">=0.12.0",
        "@shopify/react-native-skia": ">=2.0.0-next.0",
        "react-native": ">=0.78.0"
    },
    "devDependencies": {
        "@canvas-tile-engine/core": "workspace:^",
        "@canvas-tile-engine/renderer-shared": "workspace:^",
        "@shopify/react-native-skia": "^2.13.0",
        "react": "^19.0.0",
        "react-native": "^0.87.1"
    }
}
