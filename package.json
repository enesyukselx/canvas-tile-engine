{
    "name": "canvas-tile-engine",
    "version": "0.0.1",
    "private": true,
    "description": "Canvas Tile Engine monorepo",
    "author": "Enes Yüksel",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/enesyukselx/canvas-tile-engine.git"
    },
    "scripts": {
        "build": "turbo run build --filter=./packages/*",
        "install:docs": "npm --prefix docs ci",
        "build:docs": "pnpm --dir docs build",
        "typecheck:docs": "pnpm --dir docs typecheck",
        "dev": "concurrently \"pnpm dev:lib\" \"pnpm --filter vanilla-js-game-map dev\"",
        "dev:lib": "turbo run dev --filter=./packages/* --filter=!@canvas-tile-engine/renderer-server",
        "dev:example": "node run-example.js",
        "lint": "turbo run lint",
        "typecheck": "turbo run typecheck",
        "format": "turbo run format",
        "format:check": "turbo run format:check",
        "test": "turbo run test",
        "test:package": "turbo run test:package",
        "test:platform-types": "turbo run test:platform-types --filter=@canvas-tile-engine/core",
        "test:watch": "turbo run test:watch",
        "test:coverage": "turbo run test:coverage",
        "changeset": "changeset",
        "changeset:version": "changeset version && node scripts/sync-skill.mjs && pnpm install --lockfile-only",
        "release": "pnpm build && changeset publish"
    },
    "keywords": [],
    "packageManager": "pnpm@10.23.0",
    "engines": {
        "node": ">=20.19.0"
    },
    "dependencies": {
        "concurrently": "^10.0.5",
        "tsup": "^8.5.1",
        "typescript": "^5.9.3"
    },
    "devDependencies": {
        "@changesets/cli": "^2.31.0",
        "@types/node": "^25.3.3",
        "@vitest/coverage-v8": "^4.1.9",
        "oxfmt": "^0.71.0",
        "oxlint": "^1.86.0",
        "turbo": "^2.11.5",
        "vitest": "^4.1.9"
    }
}
